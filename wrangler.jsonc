{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lector",
	"compatibility_date": "2026-10-08",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lector",
			"database_id": "1422de46-bca4-444e-b912-f6ae660fc1bc",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "DOCUMENTS",
			"bucket_name": "lector-documents",
			"jurisdiction": "eu"
		}
	],
	"secrets": {
		"required": ["BETTER_AUTH_SECRET"]
	},
	"workers_dev": true,
	"preview_urls": true
}
